# CT5 FINAL / AX309. Add this UCF ONLY; remove AX309_CPU8.ucf and old ax309.ucf from project.
# AX309 50MHz clock, keys (active-low)
NET "clk50" LOC = "T8" | IOSTANDARD = LVCMOS33;
NET "clk50" TNM_NET = "clk50";
TIMESPEC "TS_clk50" = PERIOD "clk50" 20 ns HIGH 50%;
NET "reset_n" LOC = "L3" | IOSTANDARD = LVCMOS33 | PULLUP;
NET "key1_n" LOC = "C3" | IOSTANDARD = LVCMOS33 | PULLUP;
NET "key2_n" LOC = "D3" | IOSTANDARD = LVCMOS33 | PULLUP;
NET "key3_n" LOC = "E4" | IOSTANDARD = LVCMOS33 | PULLUP;
NET "key4_n" LOC = "E3" | IOSTANDARD = LVCMOS33 | PULLUP;
# Eight-segment bus: DIG[0]=A, [1]=B, ... [6]=G, [7]=DP
NET "dig[0]" LOC = "C7" | IOSTANDARD = LVCMOS33;
NET "dig[1]" LOC = "E6" | IOSTANDARD = LVCMOS33;
NET "dig[2]" LOC = "C5" | IOSTANDARD = LVCMOS33;
NET "dig[3]" LOC = "F7" | IOSTANDARD = LVCMOS33;
NET "dig[4]" LOC = "D6" | IOSTANDARD = LVCMOS33;
NET "dig[5]" LOC = "E7" | IOSTANDARD = LVCMOS33;
NET "dig[6]" LOC = "D5" | IOSTANDARD = LVCMOS33;
NET "dig[7]" LOC = "C6" | IOSTANDARD = LVCMOS33;
NET "sel[0]" LOC = "D8" | IOSTANDARD = LVCMOS33;
NET "sel[1]" LOC = "E8" | IOSTANDARD = LVCMOS33;
NET "sel[2]" LOC = "F9" | IOSTANDARD = LVCMOS33;
NET "sel[3]" LOC = "F10" | IOSTANDARD = LVCMOS33;
NET "sel[4]" LOC = "E10" | IOSTANDARD = LVCMOS33;
NET "sel[5]" LOC = "D9" | IOSTANDARD = LVCMOS33;
NET "led[0]" LOC = "P4" | IOSTANDARD = LVCMOS33;
NET "led[1]" LOC = "N5" | IOSTANDARD = LVCMOS33;
NET "led[2]" LOC = "P5" | IOSTANDARD = LVCMOS33;
NET "led[3]" LOC = "M6" | IOSTANDARD = LVCMOS33;
